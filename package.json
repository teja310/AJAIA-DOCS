{
  "name": "ajaia-docs",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "test": "npm run test -w server",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w client",
    "test:ui": "node e2e/ui-smoke.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "playwright-core": "^1.65.0"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "better-sqlite3@13.1.1": true,
    "esbuild@0.28.2": true
  }
}
